# Required: Claude API access for post-correction, classification, and entity extraction.
# Get one at https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional but recommended: HuggingFace Hub access token.
# Removes the "unauthenticated requests" warning during model downloads,
# raises rate limits (anonymous: ~100 req/hr; authenticated: 5000+/hr),
# and is required if you ever pull a gated model.
# Create one at https://huggingface.co/settings/tokens with the "Read" scope
# (we only download; we never push to the Hub).
HF_TOKEN=hf_your_token_here
